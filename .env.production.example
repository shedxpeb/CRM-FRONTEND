# =============================================================================
# ADMIN-CRM FRONTEND — PRODUCTION ENVIRONMENT
# =============================================================================
# Copy this file to .env.production and fill in ONLY the values marked 🔧
# =============================================================================

# ── 🔧 REQUIRED: Change these for every deployment ───────────────────────────

# Backend URL for API proxy (Next.js rewrites /api/* to this URL)
# ⚠️ This is the INTERNAL backend URL that Next.js server can reach.
# If backend runs on same VPS: http://127.0.0.1:3003
# If backend is behind NGINX: https://api.buildxcrm.com
BACKEND_URL=http://127.0.0.1:3003

# ── OPTIONAL: Only change if needed ──────────────────────────────────────────

# API base path (default /api — matches Next.js rewrites)
NEXT_PUBLIC_API_URL=/api

# Image hostname for next/image optimization
IMAGE_HOSTNAME=buildxcrm.com

# Node environment
NODE_ENV=production
